{
  "schemaVersion": 1,
  "id": "itemtransformer",
  "version": "${version}",
  "name": "Item Transformer",
  "description": "Change the size, position and rotation of any item. Also resize dropped items on the ground. Press K to open the editor.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.itemtransformer.ItemTransformerClient"]
  },
  "mixins": [
    { "config": "itemtransformer.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
